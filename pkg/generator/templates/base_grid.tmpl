package {{.DayPackage}}

import (
	"strings"

	"github.com/AnasImloul/aoc-go/pkg/registry"
	"github.com/AnasImloul/aoc-go/pkg/solver"
)

type Day struct {
	solver.Base
	grid [][]byte
	rows int
	cols int
}

var Solver = &Day{
	Base: solver.Base{
		Year: {{.Year}},
		Day:  {{.Day}},
	},
}

func init() {
	Solver.FirstPart = Solver.firstPart
	Solver.SecondPart = Solver.secondPart
	Solver.ParseFunc = Solver.parse
	registry.Register({{.Year}}, {{.Day}}, Solver)
}

func (d *Day) parse(input string) error {
	lines := strings.Split(input, "\n")
	// Remove empty string at the end if input ends with newline
	if len(lines) > 0 && lines[len(lines)-1] == "" {
		lines = lines[:len(lines)-1]
	}
	d.rows = len(lines)
	if d.rows > 0 {
		d.cols = len(lines[0])
	}
	// Convert []string to [][]byte
	d.grid = make([][]byte, d.rows)
	for i, line := range lines {
		d.grid[i] = []byte(line)
	}
	return nil
}

func (d *Day) inBounds(row, col int) bool {
	return row >= 0 && row < d.rows && col >= 0 && col < d.cols
}

func (d *Day) getCell(row, col int) byte {
	if !d.inBounds(row, col) {
		return 0
	}
	return d.grid[row][col]
}

func (d *Day) setCell(row, col int, value byte) {
	if !d.inBounds(row, col) {
		return
	}
	d.grid[row][col] = value
}
